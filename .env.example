# Copy to .env.local (gitignored) and fill in from the Clerk dashboard.
#
# The publishable key is safe in client code; the secret key is not, and must
# never be committed. Cloudflare's local runtime reads secrets from .dev.vars,
# so the secret goes there as well.

# Clerk — https://dashboard.clerk.com → API keys
# Vite inlines VITE_*; NEXT_PUBLIC_* is kept for parity with the Next.js naming.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Every map and live-data source the app uses is keyless:
#   OpenFreeMap (vector tiles), Overpass + Nominatim (OpenStreetMap),
#   OpenSky (aircraft), USGS (seismic), Open-Meteo (weather and air quality),
#   GDELT (news), Transport for London and Caltrans (traffic cameras).
# Nothing below is required to run the app.
